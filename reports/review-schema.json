{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex supervisor review",
  "type": "object",
  "additionalProperties": false,
  "required": ["change_request_id", "cycle", "findings"],
  "properties": {
    "change_request_id": {"type": "string", "minLength": 1},
    "cycle": {"type": "integer", "minimum": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "category", "sheet", "cell_or_range", "issue", "economic_effect", "blocks_release", "requires_jack_decision", "required_fix", "required_test"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "category": {"type": "string"},
          "sheet": {"type": ["string", "null"]},
          "cell_or_range": {"type": ["string", "null"]},
          "issue": {"type": "string"},
          "economic_effect": {"type": "string"},
          "blocks_release": {"type": "boolean"},
          "requires_jack_decision": {"type": "boolean"},
          "required_fix": {"type": "string"},
          "required_test": {"type": "string"}
        }
      }
    }
  }
}
